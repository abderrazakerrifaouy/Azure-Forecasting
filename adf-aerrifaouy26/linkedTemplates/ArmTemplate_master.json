{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-aerrifaouy26"
		},
		"LS_LAK_Source_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_LAK_Source'"
		},
		"LS_HTTP_Source_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://simplonline-v3-prod.s3.eu-west-3.amazonaws.com/media/file/csv/pjme-hourly-6951852bda3c4588058217-6b0360cfa260b742484012.csv"
		},
		"LS_LAK_Source_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://staerrifaouy26.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-aerrifaouy26_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_LAK_Source_accountKey": {
						"value": "[parameters('LS_LAK_Source_accountKey')]"
					},
					"LS_HTTP_Source_properties_typeProperties_url": {
						"value": "[parameters('LS_HTTP_Source_properties_typeProperties_url')]"
					},
					"LS_LAK_Source_properties_typeProperties_url": {
						"value": "[parameters('LS_LAK_Source_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}